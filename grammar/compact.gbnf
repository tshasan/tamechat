# HTML-subset answer grammar (compact), generated by bin/grammar.ts
root ::= ws block (ws block)* ws

ws ::= "\n"{0,2}

block ::= p | heading | ul | ol | blockquote | pre | hr | table | details | dl | aside | menu

phr  ::= tchar | entity | inline
inline ::= simple-inline | code | a | br | abbr
simple-inline ::= "<strong>" phr+ "</strong>" | "<em>" phr+ "</em>" | "<sub>" phr+ "</sub>" | "<sup>" phr+ "</sup>" | "<del>" phr+ "</del>" | "<kbd>" phr+ "</kbd>" | "<mark>" phr+ "</mark>" | "<small>" phr+ "</small>"
code ::= "<code>" [ \t]* cvis cchar* "</code>"
br   ::= "<br>"
abbr ::= "<abbr title=\"" attr-char+ "\">" (tchar | entity)+ "</abbr>"
a    ::= "<a href=\"" url "\">" (tchar | entity | code)+ "</a>"

url  ::= ("https://" | "mailto:" | "#") url-char+
url-char  ::= [^\x22<>'` \t\n]
attr-char ::= [^\x22<>&\n]

tchar  ::= [^<>&]
cchar  ::= [^<>&\n] | entity
cvis   ::= [^<>&\n \t] | entity
entity ::= "&" ("amp" | "lt" | "gt" | "quot" | "apos" | "nbsp" | "#" [0-9]{2,6}) ";"

p       ::= "<p>" phr+ "</p>"?
heading ::= "<h2>" phr+ "</h2>" | "<h3>" phr+ "</h3>" | "<h4>" phr+ "</h4>"
hr      ::= "<hr>"

ul ::= "<ul>" ws (li ws)+ "</ul>"
ol ::= "<ol" (" start=\"" [0-9]{1,4} "\"")? ">" ws (li ws)+ "</ol>"
li ::= "<li>" (phr | ul | ol | p | pre)+ "</li>"?

blockquote ::= "<blockquote>" ws (block ws)+ "</blockquote>"

pre  ::= "<pre><code" (" class=\"language-" lang "\"")? ">" pchar+ "</code></pre>"
lang ::= [a-z0-9+#_-]{1,20}
pchar ::= [^<&] | entity

table   ::= "<table>" ws caption? thead? "<tbody>" ws (tr ws)+ "</tbody>"? ws "</table>"
caption ::= "<caption>" phr+ "</caption>" ws
thead   ::= "<thead>" ws (tr ws)+ "</thead>"? ws
tr      ::= "<tr>" ws (cell ws)+ "</tr>"?
cell    ::= th | td
th      ::= "<th" span? (" scope=\"" ("col" | "row") "\"")? ">" phr* "</th>"?
td      ::= "<td" span? ">" phr* "</td>"?
span    ::= " colspan=\"" [1-9] "\"" | " rowspan=\"" [1-9] "\"" | " colspan=\"" [1-9] "\" rowspan=\"" [1-9] "\""

details ::= "<details>" ws "<summary>" phr+ "</summary>" ws (block ws)+ "</details>"

dl ::= "<dl>" ws (dt-group ws)+ "</dl>"
dt-group ::= ("<dt>" phr+ "</dt>"? ws)+ ("<dd>" phr+ "</dd>"? ws)+

aside ::= "<aside class=\"" ("note" | "tip" | "warn") "\"" (" role=\"note\"")? ">" ws (block ws)+ "</aside>"

menu ::= "<menu>" ws (choice ws)+ "</menu>"
choice ::= "<li><button" (" type=\"button\"")? " value=\"" attr-char+ "\">" (tchar | entity)+ "</button></li>"
